{
  "name": "thomas",
  "version": "0.1.8",
  "description": "Real (no-mocks) BDD step implementations for Helm, kubectl, and HTTP testing of k8s-native applications.",
  "license": "MIT",
  "type": "module",
  "files": [
    "features/step_definitions",
    "features/support",
    "README.md"
  ],
  "exports": {
    "./step_definitions/*": "./features/step_definitions/*.ts",
    "./support/*": "./features/support/*.ts"
  },
  "scripts": {
    "test": "NODE_OPTIONS='--import tsx' cucumber-js",
    "test:ff": "NODE_OPTIONS='--import tsx' cucumber-js --fail-fast",
    "test:verbose": "NODE_OPTIONS='--import tsx' cucumber-js --format pretty",
    "test:usage": "NODE_OPTIONS='--import tsx' cucumber-js --format usage",
    "test:junit": "NODE_OPTIONS='--import tsx' cucumber-js --format junit:report.xml",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict",
    "install:tools": "bash scripts/tools.sh"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/jmespath": "^0.15.2",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "jmespath": "^0.16.0",
    "js-yaml": "^5.4.3",
    "undici": "8.11.2"
  },
  "engines": {
    "node": ">=26"
  }
}
