{
  "name": "thomas",
  "version": "0.1.0",
  "description": "Real (no-mocks) BDD step implementations for Helm, kubectl, and HTTP testing of k8s-native applications.",
  "type": "module",
  "files": [
    "features/step_definitions",
    "features/support",
    "README.md"
  ],
  "exports": {
    "./step_definitions/*": "./features/step_definitions/*.ts",
    "./support/*": "./features/support/*.ts"
  },
  "scripts": {
    "test": "cucumber-js",
    "test:ff": "cucumber-js --fail-fast",
    "test:verbose": "cucumber-js --format @cucumber/pretty-formatter",
    "test:usage": "cucumber-js --format usage",
    "test:junit": "cucumber-js --format junit:report.xml",
    "docs:serve": "mkdocs serve",
    "docs:build": "mkdocs build --strict"
  },
  "peerDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@cucumber/pretty-formatter": "^4.0.2",
    "@types/jmespath": "^0.15.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "jmespath": "^0.16.0",
    "js-yaml": "^4.1.0"
  }
}
